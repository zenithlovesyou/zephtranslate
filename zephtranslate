#!/bin/bash
# zephtranslate - minimal CLI translator

VERSION="1.0.0"

# ANSI colors as real escape bytes so printf '%s' never mis-renders them
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
RESET=$'\033[0m'
if [ -n "${NO_COLOR:-}" ]; then
    RED='' GREEN='' YELLOW='' CYAN='' BOLD='' DIM='' RESET=''
fi

# Keyless Google Translate endpoints (fallback used when the first is rate limited)
TRANSLATE_API="https://translate.googleapis.com/translate_a/single"
FALLBACK_API="https://clients5.google.com/translate_a/t"
CLIENT_ID="dict-chrome-ex"

TARGET_LANG=""
SOURCE_LANG="auto"
LIST_LANGS="0"
HAVE_TEXT=""
TEXT_ARGS=()

HAVE_JQ=""
command -v jq >/dev/null 2>&1 && HAVE_JQ=1

# Language table: code|English name|extra aliases (comma separated)
LANGUAGES="
